################################################################################
# LOADING CMBKP LIBRARIES
################################################################################
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CMBKP_LIB_DIR="/usr/local/lib/cmbkp/bash"
if [ ! -d "$CMBKP_LIB_DIR" ]; then
  if [ -d "/usr/local/lib/cmbackup/bash" ]; then
    CMBKP_LIB_DIR="/usr/local/lib/cmbackup/bash"
  elif [ -d "$SCRIPT_DIR/lib/bash" ]; then
    CMBKP_LIB_DIR="$SCRIPT_DIR/lib/bash"
  elif [ -d "$SCRIPT_DIR/../lib/bash" ]; then
    CMBKP_LIB_DIR="$SCRIPT_DIR/../lib/bash"
  fi
fi

# shellcheck source=/dev/null
source "$CMBKP_LIB_DIR/HelpAction.sh"
source "$CMBKP_LIB_DIR/MiscAction.sh"
source "$CMBKP_LIB_DIR/NotifyAction.sh"
source "$CMBKP_LIB_DIR/ParallelAction.sh"
source "$CMBKP_LIB_DIR/ListAction.sh"
source "$CMBKP_LIB_DIR/BackupAction.sh"
source "$CMBKP_LIB_DIR/RestoreAction.sh"
source "$CMBKP_LIB_DIR/DeleteAction.sh"
source "$CMBKP_LIB_DIR/MigrationAction.sh"
source "$CMBKP_LIB_DIR/TableHelper.sh"
source "$CMBKP_LIB_DIR/SessionAction.sh"
[ -f "$CMBKP_LIB_DIR/TuiAction.sh" ] && source "$CMBKP_LIB_DIR/TuiAction.sh"

################################################################################
# CMBKP MAIN CODE
################################################################################
# Parse global options (--dry-run, --since, --config, --sort, --tui)
ARGS=()
export DRY_RUN="FALSE"
export SINCE_DATE=""
export SORT_BY="${SORT_BY:-}"
export TUI_MODE="FALSE"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      export DRY_RUN="TRUE"
      shift
      ;;
    --since)
      export SINCE_DATE="$2"
      shift 2
      ;;
    --config)
      export CMBKP_CONF="$2"
      export CMBACKUP_CONF="$2"
      shift 2
      ;;
    -S|--sort-size|--sort-by-size)
      export SORT_BY="size"
      shift
      ;;
    --sort-size-asc)
      export SORT_BY="size-asc"
      shift
      ;;
    --sort)
      export SORT_BY="$2"
      shift 2
      ;;
    --sort=*)
      export SORT_BY="${1#*=}"
      shift
      ;;
    --tui|-ui|tui)
      export TUI_MODE="TRUE"
      shift
      ;;
    --preview-account)
      load_config
      validate_config
      tui_preview_account "$2"
      exit 0
      ;;
    --preview-session)
      load_config
      validate_config
      tui_preview_session "$2"
      exit 0
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done
set -- "${ARGS[@]}"

load_config
validate_config
export_function
export_vars
constant

# Interactive TUI mode invocation
if [[ "$TUI_MODE" == "TRUE" ]]; then
  tui_main_menu
  exit $?
fi

case "$1" in
  "-f"|"--full" )
    if [[ "$2" == "--tui" || "$2" == "-ui" ]]; then
      tui_backup_flow
      exit $?
    fi
    checkpid
    case "$2" in
      "-dl"|"--distributionlist" )
        sessionvars "$2"
        create_temp
        backup_main "$DLOBJECT" "$DLFILTER" "$3" "$4"
        rm -rf "$PID"
      ;;
      "-al"|"--alias" )
        sessionvars "$2"
        create_temp
        backup_main "$ALOBJECT" "$ALFILTER" "$3" "$4"
        rm -rf "$PID"
      ;;
      "-ldp"|"--ldap" )
        sessionvars "$2"
        create_temp
        backup_main "$ACOBJECT" "$ACFILTER" "$3" "$4"
        rm -rf "$PID"
      ;;
      "-m"|"--mail" )
        sessionvars "$2"
        create_temp
        backup_main "$ACOBJECT" "$ACFILTER" "$3" "$4"
        rm -rf "$PID"
      ;;
      "-sig"|"--signature" )
        sessionvars "$2"
        create_temp
        backup_main "$SIOBJECT" "$SIFILTER" "$3" "$4"
        rm -rf "$PID"
      ;;
      * )
        sessionvars "$1"
        create_temp
        if [[ "$2" == *"@"* ]]; then
          backup_main "$ACOBJECT" "$ACFILTER" "-a" "$2"
        else
          backup_main "$ACOBJECT" "$ACFILTER" "$2" "$3"
        fi
        rm -rf "$PID"
      ;;
    esac
  ;;
  "-i"|"--incremental" )
    if [[ "$2" == "--tui" || "$2" == "-ui" ]]; then
      tui_backup_flow
      exit $?
    fi
    sessionvars "$1" 'TRUE'
    checkpid
    create_temp
    case "$2" in
      "-a"|"--account"|"-d"|"--domain" )
        backup_main "$ACOBJECT" "$ACFILTER" "$2" "$3"
      ;;
      * )
        if [[ "$2" == *"@"* ]]; then
          backup_main "$ACOBJECT" "$ACFILTER" "-a" "$2"
        else
          backup_main "$ACOBJECT" "$ACFILTER" "$2" "$3"
        fi
      ;;
    esac
    rm -rf "$PID"
  ;;
  "-l"|"--list" )
    list_sessions "$2" "$3"
  ;;
  "-r"|"--restore" )
    if [[ "$2" == "--tui" || "$2" == "-ui" ]]; then
      tui_restore_flow
      exit $?
    fi
    create_temp
    checkpid
    case "$2" in
      "-dl"|"--distributionlist"|"-ldp"|"--ldap"|"-al"|"--alias"|"-sig"|"--signature")
        case "$3" in
          "-a"|"--account"|"-d"|"--domain")
            restore_main_ldap "$4" "$5"
          ;;
          * )
            restore_main_ldap "$3" "$4"
          ;;
        esac
        rm -rf "$PID"
      ;;
      "-m"|"--mail" )
        restore_main_mailbox "$3" "$4" "$5"
        rm -rf "$PID"
      ;;
      "-ro"|"--restoreOnAccount" )
        if [ -z "$4" ] || [ -z "$5" ]; then
          show_help
          printf "\n\nError! Please inform the account that should be restored, and when the restore should be placed.\n\n"
          exit 2
        else
          constant
          restore_main_mailbox "$3" "$4" "$5"
          rm -rf "$PID"
        fi
      ;;
      * )
        if [[ "$2" == "full"* || "$2" == "inc"* ]]; then
          constant
          restore_main_ldap "$2" "$3" "$4"
          restore_main_mailbox "$2" "$3" "$4"
          rm -rf "$PID"
        else
          show_help
          printf "\n\nError! Invalid parameters for restore\n"
        fi
      ;;
    esac
  ;;
  "-d"|"--delete" )
    if [ -z "$2" ]; then
      show_help
      printf "\n\nError! Please inform the session that should be deleted\n\n"
    else
      checkpid
      delete_one "$2"
      rm -rf "$PID"
    fi
  ;;
  "-hp"|"--housekeep")
    checkpid
    delete_old
    clean_empty
    rm -rf "$PID"
  ;;
  "-t"|"--truncate")
    if [ -n "$2" ] && [ "--force-clean" == "$2" ]; then
      checkpid
      leeroy_jenkins
      clean_empty
      rm -rf "$PID"
    else
      echo "This action is irreversible - Use the option --force-clean to override this message"
    fi
  ;;
  "-c"|"--verify" )
    audit_mailboxes "$2" "$3"
  ;;
  "--tui"|"-ui"|"tui" )
    tui_main_menu
  ;;
  "-h"|"--help" )
    show_help
  ;;
  "-v"|"--version" )
    echo "cmbkp version: 1.3.0 (alias: cmbackup)"
  ;;
  "-m"|"--migrate" )
    checkpid
    migration
    rm -rf "$PID"
  ;;
  * )
    show_help
    printf "\n\nError! Incorrect options\n\n"
  ;;
esac
exit 0
